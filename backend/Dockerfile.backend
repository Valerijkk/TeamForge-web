# ===== Runtime: Python backend (Flask/Flask-SocketIO) =====
FROM python:3.11-slim

# Системные зависимости при необходимости (libpq-dev, gcc и т.п.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Установим зависимости
# Важно: положи рядом requirements.txt
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходники
COPY . .

# Если есть .env — можно скопировать
# COPY .env .env

ENV PYTHONUNBUFFERED=1
EXPOSE 5000

# Поменяй на свою стартовую команду/модуль
# пример для Flask: gunicorn -k eventlet -w 1 app:app --bind 0.0.0.0:5000
CMD ["python", "app.py"]
